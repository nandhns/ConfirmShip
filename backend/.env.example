CHALLENGE_SERVER_URL=http://localhost:8081 #Make sure to change this to the actual port number you're using for the challenge server. If you're using the default port (8080), you can change to 8080.

# AI / OCR / LLM Configuration
OCR_PROVIDER=gemini       # Options: gemini, openai, tesseract
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI (if switching providers)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
